{
  "name": "api-example-linter-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "test": "cargo test && npm run test:site",
    "test:site": "node --test site/tests/*.test.mjs",
    "build": "npm run build:cli && npm run build:site",
    "build:cli": "cargo build --release && mkdir -p dist/bin && cp target/release/api-example-linter dist/bin/",
    "build:site": "vite build --config site/vite.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
